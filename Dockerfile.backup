FROM mongo:8.0
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc \
    && chmod 0755 /usr/local/bin/mc && /usr/local/bin/mc --version \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/backup-and-test-railway-mongo.sh /usr/local/bin/acg-mongo-backup-test
RUN chmod 0755 /usr/local/bin/acg-mongo-backup-test
ENTRYPOINT ["/usr/local/bin/acg-mongo-backup-test"]
