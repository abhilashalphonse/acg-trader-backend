# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000

# MongoDB
MONGODB_URI=mongodb+srv://proptech:7G6I2BrBJUPrMFOv@cluster0.ezf5i3c.mongodb.net/?appName=Cluster0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Instrument catalog
INSTRUMENT_CATALOG_AUTO_SEED=true

# Market Gateway
MARKET_GATEWAY_ENABLED=true
MARKET_PROVIDER=twelve-data
