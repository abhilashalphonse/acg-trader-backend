# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/acg-trader
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Twelve Data diagnostic / future market-data adapter
TWELVE_DATA_API_KEY=your_api_key_here
TWELVE_DATA_SYMBOLS=EUR/USD,XAU/USD
TWELVE_DATA_TEST_MINUTES=15
