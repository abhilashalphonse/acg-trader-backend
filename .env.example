


# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5174
SHUTDOWN_TIMEOUT_MS=10000

# MongoDB
MONGODB_URI=mongodb+srv://abhilashalphonsedev_db_user:5VaVUW7r0J1CitsN@db1.js6cpr2.mongodb.net/acg_trader?appName=DB1
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Trading
TRADING_API_ENABLED=true
INSTRUMENT_CATALOG_AUTO_SEED=true

# Authentication
AUTH_SESSION_TTL_SECONDS=3600
AUTH_FEDERATION_TICKET_TTL_SECONDS=60
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900

# Market Gateway
MARKET_GATEWAY_ENABLED=true
MARKET_PROVIDER=twelve-data
MARKET_SYMBOLS=EURUSD,XAUUSD

MARKET_CANDLE_TIMEFRAMES=1s,5s,15s,30s,1m,5m,15m,1h,4h,1d
MARKET_PERSIST_TIMEFRAMES=5s,15s,30s,1m,5m,15m,1h,4h,1d

MARKET_DEFAULT_MAX_QUOTE_AGE_MS=5000
MARKET_STALE_CHECK_MS=1000
MARKET_CANDLE_FLUSH_INTERVAL_MS=250
MARKET_MAX_SYNTHETIC_GAP_BARS=12

# WebSocket
MARKET_WS_PATH=/v1/ws
MARKET_WS_PING_INTERVAL_MS=30000
MARKET_WS_MAX_BUFFER_BYTES=1048576

# Twelve Data
TWELVE_DATA_API_KEY=a5ecc8590b084f89b95c2da74f49e3fc
TWELVE_DATA_WS_URL=wss://ws.twelvedata.com/v1/quotes/price
TWELVE_DATA_API_BASE=https://api.twelvedata.com
TWELVE_DATA_HEARTBEAT_MS=10000
TWELVE_DATA_RECONNECT_MIN_MS=1000
TWELVE_DATA_RECONNECT_MAX_MS=30000
TWELVE_DATA_HTTP_TIMEOUT_MS=10000



# Reconciliation
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=300000

# Trader -> Funded platform events
PLATFORM_EVENTS_ENABLED=true
ACG_FUNDED_WEBHOOK_URL=http://localhost:3000/api/webhooks/acg-trader
ACG_FUNDED_WEBHOOK_SECRET=local-acg-funded-webhook-secret-32chars

PLATFORM_EVENT_POLL_INTERVAL_MS=1000
PLATFORM_EVENT_TIMEOUT_MS=5000
PLATFORM_EVENT_BATCH_SIZE=100
PLATFORM_EVENT_MAX_ATTEMPTS=12

# Used by npm run tenant:create
TENANT_SLUG=acg-funded
TENANT_NAME=ACG Funded Local
TENANT_CLIENT_ID=acg-funded-backend
TENANT_SCOPES=accounts:write,federation:write